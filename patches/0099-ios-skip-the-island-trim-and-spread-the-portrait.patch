From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Tue, 17 Nov 2026 07:54:57 +0800
Subject: [PATCH] ios: skip the island trim and spread the portrait pad

The picture takes the top half of the whole screen, and the pad's columns and rows move outward to 0.375/0.625 and 0.5/0.875 for comparison.

Upstream-Status: fork-only
Reason: a comparison build that keeps the island area and spreads the portrait pad
Issue: none yet: no upstream issue for the companion

---
 dm/ios/Sources/DmLayout.h                | 13 ++---
 dm/ios/Sources/DmPadGeometry.h           |  4 +-
 dm/ios/tests/duo/Tests/DuoHarnessTests.m | 60 ++++++++++++------------
 3 files changed, 39 insertions(+), 38 deletions(-)

diff --git a/dm/ios/Sources/DmLayout.h b/dm/ios/Sources/DmLayout.h
index f6dafab0..2be69220 100644
--- a/dm/ios/Sources/DmLayout.h
+++ b/dm/ios/Sources/DmLayout.h
@@ -45,7 +45,8 @@ static inline BOOL dm_picture_fill(const char *_Nullable value) { return value &
 // wider (a 19.5:9 phone lying down at 2.17:1), else 16:9. A phone standing up takes the shape of the band above the panel: half the window less the
 // safe area's top (the Dynamic Island), so the picture fills that band without cropping. The range is loader.c's (0.9 to 2.4). 0 = 16:9.
 static inline float dm_picture_shape_auto(CGSize window, CGFloat topInset) {
-    double r = window.height > window.width ? window.width / MAX((window.height - topInset) * 0.5, 1)
+    (void)topInset;
+    double r = window.height > window.width ? window.width / MAX(window.height * 0.5, 1)
                                             : MAX(window.width, window.height) / MAX(MIN(window.width, window.height), 1);
     return r >= 0.9 && r < 2.4 ? (float)r : 0.0f;
 }
@@ -72,12 +73,12 @@ static inline DmLayout dm_layout(CGRect b, UIEdgeInsets insets, BOOL partiallyOp
     // is computed for that half at launch (dm_picture_shape_auto), so it fills the upper rectangle without bars. A fold sets both edges within the safe area.
     BOOL folded = !CGRectIsNull(division);
     CGRect safe = UIEdgeInsetsInsetRect(b, insets);
-    // A standing phone splits the area below the safe top (the Dynamic Island) in half: the picture takes the upper half of that area,
-    // the panel the lower half. Both are equal, and neither reaches into the island.
-    CGFloat upperBottom = folded ? CGRectGetMinY(division)
-                                 : CGRectGetMinY(safe) + (CGRectGetMaxY(b) - CGRectGetMinY(safe)) * 0.5;
+    // A standing phone splits the screen at its midpoint: the picture takes the upper half, the panel the lower half. A fold sets both edges
+    // within the safe area instead.
+    CGFloat upperBottom = folded ? CGRectGetMinY(division) : CGRectGetMidY(b);
     CGFloat bandTop = folded ? CGRectGetMaxY(division) : upperBottom;
-    CGRect upper = CGRectMake(CGRectGetMinX(safe), CGRectGetMinY(safe), safe.size.width, upperBottom - CGRectGetMinY(safe));
+    CGRect upper = folded ? CGRectMake(CGRectGetMinX(safe), CGRectGetMinY(safe), safe.size.width, upperBottom - CGRectGetMinY(safe))
+                          : CGRectMake(CGRectGetMinX(b), CGRectGetMinY(b), b.size.width, upperBottom - CGRectGetMinY(b));
     CGRect lower = CGRectMake(CGRectGetMinX(b), bandTop, b.size.width, CGRectGetMaxY(b) - bandTop);
     if (upper.size.height <= 0) return l;
     l.game = dm_aspect_fit(upper, aspect); l.companion = lower; l.controls = lower; l.separated = YES;
diff --git a/dm/ios/Sources/DmPadGeometry.h b/dm/ios/Sources/DmPadGeometry.h
index 10382b41..74924c50 100644
--- a/dm/ios/Sources/DmPadGeometry.h
+++ b/dm/ios/Sources/DmPadGeometry.h
@@ -108,8 +108,8 @@ static inline DmPadGeo dm_pad_geo_at(CGRect bounds, UIEdgeInsets insets, DmLayou
     if (g.portrait) {
         // Two columns, with each thumb's pair at a fixed height of the band: the stick and the diamond sit together just below the middle,
         // the D-pad and the right stick together near the bottom, leaving the top of the band clear for the panel.
-        CGFloat xl = CGRectGetMinX(s) + s.size.width * 0.25, xr = CGRectGetMinX(s) + s.size.width * 0.75;
-        CGFloat yTop = CGRectGetMinY(s) + s.size.height * 0.45, yLow = CGRectGetMinY(s) + s.size.height * 0.80;
+        CGFloat xl = CGRectGetMinX(s) + s.size.width * 0.375, xr = CGRectGetMinX(s) + s.size.width * 0.625;
+        CGFloat yTop = CGRectGetMinY(s) + s.size.height * 0.50, yLow = CGRectGetMinY(s) + s.size.height * 0.875;
         g.stick = CGPointMake(xl, yTop);
         g.face = CGPointMake(xr, yTop);
         g.dpad = CGPointMake(xl, yLow);
diff --git a/dm/ios/tests/duo/Tests/DuoHarnessTests.m b/dm/ios/tests/duo/Tests/DuoHarnessTests.m
index c9cf2bb9..9297a0fa 100644
--- a/dm/ios/tests/duo/Tests/DuoHarnessTests.m
+++ b/dm/ios/tests/duo/Tests/DuoHarnessTests.m
@@ -246,14 +246,14 @@ static BOOL gDuoHarnessReduceMotionEnabled;
         CGFloat aspect = dm_picture_shape_auto(bounds.size, insets[i].top);
         DmLayout layout = dm_layout(bounds, insets[i], NO, CGRectNull, aspect);
         // No fold: the area below the safe top splits in half, the picture fills the upper half and the panel the lower half
-        CGFloat splitY = insets[i].top + (bounds.size.height - insets[i].top) * 0.5;
+        CGFloat splitY = CGRectGetMidY(bounds);
         XCTAssertTrue(layout.separated);
         XCTAssertTrue(CGRectEqualToRect(layout.companion, CGRectMake(0, splitY, bounds.size.width, bounds.size.height - splitY)),
                       @"The panel keeps the lower half");
         XCTAssertTrue(CGRectEqualToRect(layout.controls, layout.companion),
                       @"The pad floats over the whole band");
         XCTAssertEqualWithAccuracy(layout.game.size.width / layout.game.size.height, aspect, 0.001);
-        XCTAssertEqualWithAccuracy(layout.game.size.height, splitY - insets[i].top, 0.5, @"The picture fills the upper half");
+        XCTAssertEqualWithAccuracy(layout.game.size.height, splitY, 0.5, @"The picture fills the upper half");
         XCTAssertLessThanOrEqual(CGRectGetMaxY(layout.game), CGRectGetMinY(layout.companion), @"The band's top leaves no video/panel overlap");
     }
 }
