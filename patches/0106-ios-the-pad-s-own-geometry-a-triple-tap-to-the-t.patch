+        [CATransaction begin]; [CATransaction setAnimationDuration:0.4];
+        [CATransaction setCompletionBlock:^{ s->_navHint.hidden = YES; }];
+        s->_navHint.opacity = 0; [CATransaction commit];
+    });
+}
