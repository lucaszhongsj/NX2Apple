+        if let a=d["anim"] as? [String:Any],let k=a["bind"] as? String,number(k)==0{return false}
+        if let k=d["need_bind"] as? String,number(k)==0{return false}
+        if let k=d["hide_bind"] as? String {
+            let n=number(k)
