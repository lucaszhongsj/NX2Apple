+Image Art::ModelIcon(std::string_view archive) {
+    if (!SafeName(archive))
+        return {};
+    const auto arc = romfs.Model(archive);
+    if (!arc)
+        return {};
+    for (const auto& [name, bytes] : arc->members) {
+        Image img;
+        if (BfresBntxDecode(bytes, {}, img))
+            return img;
+    }
+    return {};
