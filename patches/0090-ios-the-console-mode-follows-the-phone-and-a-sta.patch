From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Tue, 17 Nov 2026 01:17:19 +0800
Subject: [PATCH] ios: the console mode follows the phone, and a standing
 picture takes half the band

Standing up the game's own keyboard needs the handheld mode; lying down
the profile's, as the player set it. A turn takes the mode again, so a
choice made in the in-game menu holds until the phone turns.

A phone standing up asks for the shape of its picture's band (half the
window: 402x874 gives 0.92) instead of 16:9, so the game fills that band
without cropping. loader.c takes a width / height down to 0.9.

Upstream-Status: fork-only
Reason: the split keeps the picture above the band, where the phone's own orientation decides the console mode and the picture's shape
Issue: none yet: no upstream issue for the companion

---
 dm/host/loader.c           |  2 +-
 dm/ios/Sources/DmLayout.h  | 10 +++++-----
 dm/ios/Sources/front_ios.m | 21 +++++++++++++++------
 3 files changed, 21 insertions(+), 12 deletions(-)

diff --git a/dm/host/loader.c b/dm/host/loader.c
index ac0a6b1c..26934d75 100644
--- a/dm/host/loader.c
+++ b/dm/host/loader.c
@@ -358,7 +358,7 @@ void dm_fps_state_apply(void) {
     const char *as = getenv("DM_SCREEN_ASPECT");
     if (as && *as && strcmp(as, "0") && strcmp(as, "auto")) {   // 0: 16:9; auto: the iOS front end resolves it to the screen's shape (a Mac window has none)
         char *end; float a = strtof(as, &end);
-        if (end == as || *end || !(a >= 1.3f && a < 2.4f)) LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 1.3 to 2.4; keeping 16:9", as);
+        if (end == as || *end || !(a >= 0.9f && a < 2.4f)) LOG("[RED] DM_SCREEN_ASPECT=%s: a width / height from 0.9 to 2.4; keeping 16:9", as);
         else {
             uint32_t oh = (uint32_t)(1920.0f / a / 8.0f + 0.5f) * 8, lh = oh * 2 / 3; float lf = (float)lh;
             memcpy(dm_fps_state + 0x48, &oh, 4); memcpy(dm_fps_state + 0x4c, &lh, 4); memcpy(dm_fps_state + 0x50, &lf, 4);
diff --git a/dm/ios/Sources/DmLayout.h b/dm/ios/Sources/DmLayout.h
index eb938c40..b7170594 100644
--- a/dm/ios/Sources/DmLayout.h
+++ b/dm/ios/Sources/DmLayout.h
@@ -42,12 +42,12 @@ static inline CGRect dm_aspect_fill(CGRect b, CGFloat aspect) {
 static inline BOOL dm_picture_fill(const char *_Nullable value) { return value && !strcmp(value, "fill"); }   // DM_PICTURE_FIT: fit (default) or fill
 
 // Picture shape "auto" (the launcher's Match screen): the window's own shape when it is taller than 16:9 (an iPad's 4:3, an unfolded iPhone Duo's 1.43:1) or
-// wider (a 19.5:9 phone lying down at 2.17:1), else 16:9. A phone standing up keeps 16:9: its picture's band takes the height the picture's own width asks
-// for (dm_layout), so a 16:9 picture fills the width with no bars and the band keeps the rest of the window. The range is loader.c's (1.3 to 2.4). 0 = 16:9.
+// wider (a 19.5:9 phone lying down at 2.17:1), else 16:9. A phone standing up takes the shape of its picture's band instead (half the window): the splash
+// of a wide screen turned on its side, so the game fills the band without cropping. The range is loader.c's (0.9 to 2.4). 0 = 16:9.
 static inline float dm_picture_shape_auto(CGSize window) {
-    double r = MAX(window.width, window.height) / MAX(MIN(window.width, window.height), 1);
-    if (window.height > window.width && r >= 1.77) r = 0;   // a phone standing up is not a wide screen
-    return r >= 1.3 && r < 2.4 ? (float)r : 0.0f;
+    double r = window.height > window.width ? window.width / MAX(window.height * 0.5, 1)
+                                            : MAX(window.width, window.height) / MAX(MIN(window.width, window.height), 1);
+    return r >= 0.9 && r < 2.4 ? (float)r : 0.0f;
 }
 
 static inline CGRect dm_horizontal_division(CGRect b, CGRect division) {
diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index 9d84e277..0c9e63f1 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -109,7 +109,9 @@ void dm_companion_ui_dock_insets(double left, double right, double bottom);   //
 @property (nonatomic, strong) UIView *pad;
 @property (nonatomic, strong) UILabel *fps;
 @property (nonatomic) BOOL launched;
-@property (nonatomic) BOOL launchModeChosen;   // the first layout pass took the console mode the game starts in
+@property (nonatomic) BOOL modeChosen;            // the first layout pass took the console mode; a turn takes it again
+@property (nonatomic) BOOL lastStanding;             // the phone's orientation at that pass, so only a turn takes the mode
+@property (nonatomic) NSInteger profileMode;         // the console mode the profile starts with, which lying down returns to
 @property (nonatomic, strong) id tv;   // the TV scene accessory's registration (iOS 27)
 @property (nonatomic) BOOL fill;   // DM_PICTURE_FIT=fill: in landscape the picture covers the screen, its edges cropped (DmLayout.h dm_layout_picture)
 @property (nonatomic) BOOL partiallyOpen;   // an iPhone Duo's hinge half open (UIHingeInteraction, iOS 27.1)
@@ -257,11 +259,18 @@ static UIWindow *g_tv;   // the TV scene's window while one shows the picture (t
 - (void)viewDidLayoutSubviews {
     [super viewDidLayoutSubviews];
     CGRect b = self.view.bounds; if (!self.game) return;
-    // The console mode belongs to the player once the game runs, but the one it starts in follows the phone: standing up the game's own keyboard needs
-    // the handheld mode, so the first layout pass takes it, and turning the phone afterwards changes only where the picture and the band go.
-    if (!self.launchModeChosen) {
-        self.launchModeChosen = YES;
-        if (b.size.height > b.size.width && !g_tv && dm_opmode() != 0) { dm_set_opmode(0); dm_gamepad_opmode_changed(); LOG("front end: console mode handheld, the phone starts standing up"); }
+    // The console mode follows the phone while no TV shows the picture: standing up the game's own keyboard needs the handheld mode, lying down the one the
+    // profile starts with. Only a turn takes it, so a mode the player picks in the in-game menu stays until the phone turns again.
+    if (!g_tv) {
+        BOOL standing = b.size.height > b.size.width, first = !self.modeChosen;
+        if (first) { self.modeChosen = YES; self.profileMode = dm_opmode(); }
+        if (first || self.lastStanding != standing) {
+            self.lastStanding = standing;
+            int want = standing ? 0 : (int)self.profileMode;
+            if (dm_opmode() != want) { dm_set_opmode(want); dm_gamepad_opmode_changed();
+                LOG("front end: console mode %s, the phone %s", standing ? "handheld" : "the profile's", standing ? "standing up" : "lying down"); }
+            LOG("front end: picture shape %.3f for the phone %s", dm_picture_shape_auto(b.size), standing ? "standing up" : "lying down");
+        }
     }
     CGRect division = CGRectNull;   // an iPhone Duo's fold, as UIKit reports it (iOS 27.1)
     NSMutableArray<NSString *> *regionLog = [NSMutableArray array];
