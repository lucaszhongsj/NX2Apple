diff --git a/dm/tools/companion_pins.py b/dm/tools/companion_pins.py
new file mode 100644
index 00000000..7c09c605
--- /dev/null
+++ b/dm/tools/companion_pins.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Eden Duo's ACNH code pins, checked against the patched main image the host maps.
+
+Usage: python3 dm/tools/companion_pins.py <main.patched.bin> <pins.inc>...
+
+The .inc files in dm/third_party/eden_duo/acnh hold the exact instruction words of the
+functions the companion finds; the module closes the domain a differing word belongs to,
+so a new build would take panels away without an error. Each pin carries its main-relative
+offset, and the host maps the patched image from its first byte, so that is also the file
+offset. A pin past the end of the image is a mismatch, and a .inc file with no pin, or a
+line that cannot be read, fails as well: a skipped pin is a domain that closes silently.
+The image's build ID is the one patch_nso.py writes beside it (main.cuts.tsv); a .inc
+whose header names another build fails before any word is compared; when there is no cuts
+file beside the image the words alone decide, and the check says so.
+
+Needs game files to say anything, not to be imported: the tests build their own image
+and .inc text.
+"""
+import argparse
+import re
+import struct
+import sys
+from collections import namedtuple
+from pathlib import Path
+
+PIN = re.compile(r'inline const \w+\s+(\w+)\s*\{\s*"([^"]+)"\s*,\s*0x([0-9a-fA-F]+)\s*,\s*\{([^}]*)\}\s*\}\s*;')
+WORD = re.compile(r'0x[0-9a-fA-F]{1,8}')
+STATED = re.compile(r'build ([0-9a-fA-F]{16})')
+BUILD_ID = re.compile(r'#\s*BUILD_ID\s+([0-9a-fA-F]{32})\s*')
+
+Pin = namedtuple('Pin', 'source name offset words stated')
+
+
+def parse_pins(path):
+    """One .inc file's pins, in order, each with the build its header names (None if it names none)."""
+    text = path.read_text()
+    found = STATED.search(text)
+    stated = found.group(1).lower() if found else None
+    pins = []
+    for n, line in enumerate(text.splitlines(), 1):
+        line = line.strip()
+        if not line or line.startswith('//'): continue
+        m = PIN.fullmatch(line)
+        if not m:
+            raise ValueError(f'{path}:{n}: not a pin: {line[:60]}')
+        name, offset, words = m.group(2), int(m.group(3), 16), [w.strip() for w in m.group(4).split(',') if w.strip()]
+        if not words or any(not WORD.fullmatch(w) for w in words):
+            raise ValueError(f'{path}:{n}: {name}: bad instruction words')
+        pins.append(Pin(path, name, offset, tuple(int(w, 16) for w in words), stated))
+    if not pins:
+        raise ValueError(f'{path}: no pins')
+    return pins
+
+
+def check(image, pins):
+    """The (pin, word index, expected, found) of every word that differs; found is None past the image's end."""
+    out, size = [], image.stat().st_size
+    with image.open('rb') as f:
+        for pin in pins:
+            for i, want in enumerate(pin.words):
+                at = pin.offset + 4 * i
+                if at + 4 > size:
+                    out.append((pin, i, want, None)); break
+                f.seek(at)
+                got, = struct.unpack('<I', f.read(4))
+                if got != want: out.append((pin, i, want, got))
+    return out
+
+
+def image_build(image):
+    """The build ID patch_nso.py writes beside the image, or None when there is no cuts file."""
+    cuts = image.with_name('main.cuts.tsv')
+    if not cuts.exists(): return None
+    with cuts.open() as f:
+        m = BUILD_ID.fullmatch(f.readline())
+    return m.group(1).lower() if m else None
+
+
+def other_builds(pins, build):
+    """The .inc files whose header names a build other than the image's."""
+    if not build: return []
+    return sorted({p.source for p in pins if p.stated and p.stated != build[:16]})
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument('image', type=Path, help='the patched main image (main.patched.bin)')
+    ap.add_argument('pins', nargs='+', type=Path, help='the .inc files')
+    a = ap.parse_args()
+    try:
+        pins = [p for path in a.pins for p in parse_pins(path)]
+    except (ValueError, OSError) as e:
+        print(f'companion_pins: {e}', file=sys.stderr)
+        return 2
+    build = image_build(a.image)
+    if not build:
+        print('companion_pins: no main.cuts.tsv beside the image: the build ID is not checked', file=sys.stderr)
+    wrong = other_builds(pins, build)
+    for path in wrong:
+        print(f'companion_pins: {path} was generated from another build than {build}', file=sys.stderr)
+    if wrong: return 1
+    counts = {p.source.name: 0 for p in pins}
+    for p in pins: counts[p.source.name] += 1
+    listed = ', '.join(f'{name} {n}' for name, n in counts.items())
+    bad = check(a.image, pins)
+    for pin, i, want, got in bad:
+        found = 'past the end of the image' if got is None else f'{got:#010x}'
+        print(f'{pin.source}: {pin.name} at {pin.offset:#x} word {i}: {want:#010x}, image has {found}')
+    if bad:
+        n = len(bad)
+        print(f'companion_pins: {n} word{"s" if n != 1 else ""} differ{"s" if n == 1 else ""} in {len({p.name for p, _, _, _ in bad})} of {len(pins)} pins ({listed})'
+              + (f' build {build}' if build else ''))
+        return 1
+    n = len(pins)
+    print(f'companion_pins: {n} pin{"s" if n != 1 else ""} match{"es" if n == 1 else ""} ({listed})' + (f' build {build}' if build else ''))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/dm/tools/tests/test_companion_pins.py b/dm/tools/tests/test_companion_pins.py
new file mode 100644
index 00000000..e4b34236
--- /dev/null
+++ b/dm/tools/tests/test_companion_pins.py
@@ -0,0 +1,116 @@
+"""Eden Duo's pin check (dm/tools/companion_pins.py) on synthetic .inc text and images,
+no game files: every word found, one changed, a pin past the end of the image, a line
+that is not a pin, a file without pins, a name in two files, and a .inc generated for
+another build than the image's cuts file names."""
+import struct
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+import companion_pins as cp
+
+# The emitted formatting: one pin a line, comments between, the build in the header.
+LIVE = '''// Generated from the 3.0.3 main (build ff1d1c05670db602...).
+// Exact instruction words; a mismatch fails the dependent domain closed.
+inline const Pin PinSaveMgr{"SaveMgr", 0x6e19d8, {0xf0026c88, 0x91010108, 0xf9400108}};
+// save object vtable slot 2: ldr x0,[x0,#0x10]; ret
+inline const Pin PinSlotData{"SlotData", 0x260bd28, {0xf9400800, 0xd65f03c0}};
+'''
+BAG = '''// Generated from the 3.0.3 main (build ff1d1c05670db602...).
+inline const BagPin PinBagSwap{"BagSwap", 0x26fd1f8, {0xb9415808, 0x52800299}};
+inline const BagPin PinPocketSlot{"PocketSlot", 0x32874e8, {0x94000248, 0xf9004680}};
+'''
+BUILD = 'ff1d1c05670db6021c85b624a710b963'
+
+
+def write(root, name, text):
+    p = Path(root) / name
+    p.write_text(text)
+    return p
+
+
+def image(root, words):
+    """An image holding the given words ({offset: [u32, ...]}), as long as its last one."""
+    p = Path(root) / 'main.patched.bin'
+    data = bytearray(max(o + 4 * len(ws) for o, ws in words.items()))
+    for o, ws in words.items():
+        struct.pack_into('<' + 'I' * len(ws), data, o, *ws)
+    p.write_bytes(data)
+    return p
+
+
+class Pins(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.tmp.cleanup)
+
+    def test_every_word_found(self):
+        live = write(self.tmp.name, 'live.inc', LIVE)
+        img = image(self.tmp.name, {0x6e19d8: [0xf0026c88, 0x91010108, 0xf9400108],
+                                    0x260bd28: [0xf9400800, 0xd65f03c0]})
+        pins = cp.parse_pins(live)
+        self.assertEqual([(p.name, p.offset) for p in pins], [('SaveMgr', 0x6e19d8), ('SlotData', 0x260bd28)])
+        self.assertEqual(pins[0].stated, BUILD[:16])
+        self.assertEqual(cp.check(img, pins), [])
+
+    def test_one_changed_word(self):
+        live = write(self.tmp.name, 'live.inc', LIVE)
+        img = image(self.tmp.name, {0x6e19d8: [0xf0026c88, 0x91010108, 0xdeadbeef],
+                                    0x260bd28: [0xf9400800, 0xd65f03c0]})
+        bad = cp.check(img, cp.parse_pins(live))
+        self.assertEqual(len(bad), 1)
+        pin, i, want, got = bad[0]
+        self.assertEqual((pin.name, i, want, got), ('SaveMgr', 2, 0xf9400108, 0xdeadbeef))
+
+    def test_pin_past_the_end_is_a_mismatch(self):
+        live = write(self.tmp.name, 'live.inc', 'inline const Pin PinSaveMgr{"SaveMgr", 0x6e19d8, {0xf0026c88}};\n')
+        img = image(self.tmp.name, {0x100: [0]})
+        bad = cp.check(img, cp.parse_pins(live))
+        self.assertEqual([(p.name, i, got) for p, i, _, got in bad], [('SaveMgr', 0, None)])
+
+    def test_a_pin_running_past_the_end_stops_at_its_first_missing_word(self):
+        live = write(self.tmp.name, 'live.inc', 'inline const Pin PinEdge{"Edge", 0x100, {0x0, 0x1}};\n')
+        img = image(self.tmp.name, {0x100: [0]})
+        bad = cp.check(img, cp.parse_pins(live))
+        self.assertEqual([(p.name, i, got) for p, i, _, got in bad], [('Edge', 1, None)])
+
+    def test_a_line_that_is_not_a_pin_fails(self):
+        bad = write(self.tmp.name, 'bad.inc', 'inline const Pin PinBad{"Bad", 0x10};\n')
+        with self.assertRaises(ValueError): cp.parse_pins(bad)
+
+    def test_a_bad_instruction_word_fails(self):
+        bad = write(self.tmp.name, 'bad.inc', 'inline const Pin PinBad{"Bad", 0x10, {0x1, 0xzz}};\n')
+        with self.assertRaises(ValueError): cp.parse_pins(bad)
+
+    def test_a_file_without_pins_fails(self):
+        empty = write(self.tmp.name, 'empty.inc', '// nothing here\n')
+        with self.assertRaises(ValueError): cp.parse_pins(empty)
+
+    def test_a_name_in_two_files_is_two_pins(self):
+        live = write(self.tmp.name, 'live.inc', LIVE)
+        bag = write(self.tmp.name, 'bag.inc', BAG.replace('BagSwap', 'PocketSlot'))
+        pins = cp.parse_pins(live) + cp.parse_pins(bag)
+        self.assertEqual([p.name for p in pins], ['SaveMgr', 'SlotData', 'PocketSlot', 'PocketSlot'])
+        img = image(self.tmp.name, {0x6e19d8: [0xf0026c88, 0x91010108, 0xf9400108],
+                                    0x260bd28: [0xf9400800, 0xd65f03c0],
+                                    0x26fd1f8: [0xb9415808, 0x52800299],
+                                    0x32874e8: [0x94000248, 0xf9004680]})
+        self.assertEqual(len(cp.check(img, pins)), 0)
+
+    def test_the_image_build_and_the_pins_build(self):
+        img = image(self.tmp.name, {0x10: [0]})
+        (Path(self.tmp.name) / 'main.cuts.tsv').write_text(f'# BUILD_ID\t{BUILD}\n0x5c9b80\t29200c29\tc23a6f15\ta cut\n')
+        live = write(self.tmp.name, 'live.inc', LIVE)
+        self.assertEqual(cp.image_build(img), BUILD)
+        self.assertEqual(cp.other_builds(cp.parse_pins(live), BUILD), [])
+        old = write(self.tmp.name, 'old.inc', LIVE.replace(BUILD[:16], '0123456789abcdef'))
+        self.assertEqual(cp.other_builds(cp.parse_pins(old), BUILD), [old])
+
+    def test_no_cuts_file_leaves_the_build_unknown(self):
+        self.assertIsNone(cp.image_build(image(self.tmp.name, {0x10: [0]})))
+
+
+if __name__ == '__main__':
+    unittest.main()
