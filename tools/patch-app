#!/usr/bin/env bash
# Apply this checkout's own engine patches to the engine of an installed NX2Apple.app, and sign the app again.
#   tools/patch-app                    apply the patches listed in patches/local
#   tools/patch-app --patches 0056 0057 0058   apply these patches instead (their numbers in patches/series)
#   tools/patch-app --restore          put the app's own engine back
#   tools/patch-app --app PATH         the installed app (default: /Applications/NX2Apple.app)
#   tools/patch-app --series FILE      another series (default: patches/series)
#
# patches/local lists the personal branch's patches, one name per line; without it, the series' fork-only ones.
# The app carries its engine as Contents/Resources/engine, the source tree a build reads. Every patch is dry-run first:
# one that does not fit the app's engine stops the run before anything changes, and names the patch. The app's own engine
# is kept in ~/Library/Application Support/nx2-wide-engine/engine-backup the first time, for --restore.
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
APP=${NX2_APP:-/Applications/NX2Apple.app}
SERIES=$ROOT/patches/series
BACKUP="$HOME/Library/Application Support/nx2-wide-engine/engine-backup"
MODE=install
WANTED=""

usage() { sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }
die() { echo "patch-app: $*" >&2; exit 1; }
note() { echo "patch-app: $*"; }

while [ $# -gt 0 ]; do
    case $1 in
        --restore) MODE=restore; shift ;;
        --app) APP=${2:?--app needs a path}; shift 2 ;;
        --series) SERIES=${2:?--series needs a path}; shift 2 ;;
        --patches) shift; while [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; do WANTED="$WANTED $1"; shift; done ;;
        -h|--help) usage 0 ;;
        *) usage 1 ;;
    esac
done

ENGINE="$APP/Contents/Resources/engine"
[ -d "$ENGINE" ] || die "no engine at $ENGINE (--app PATH)"
[ -f "$SERIES" ] || die "no series at $SERIES (--series FILE)"
if pgrep -x NSPortBuilder >/dev/null; then die "quit NX2Apple first: it is running"; fi

sign() {
    codesign --force --deep -s - "$APP" >/dev/null 2>&1 || die "signing $APP failed"
    codesign --verify --deep --strict "$APP" >/dev/null 2>&1 || die "$APP does not verify after signing"
}

if [ "$MODE" = restore ]; then
    [ -d "$BACKUP" ] || die "no backup at $BACKUP"
    /bin/rm -rf "$ENGINE"
    ditto "$BACKUP" "$ENGINE"
    sign
    note "restored the app's own engine; restart NX2Apple"
    exit 0
fi

# The patches to apply: the ones named on the command line, else the series' fork-only entries.
LIST=$(mktemp "${TMPDIR:-/tmp}/patch-app.XXXXXX")
trap '/bin/rm -f "$LIST"' EXIT
if [ -n "$WANTED" ]; then
    for n in $WANTED; do
        f=$(awk -v n="$n" 'index($0, n "-") == 1 { print; exit }' "$SERIES")
        [ -n "$f" ] || die "no patch $n in $SERIES"
        echo "$ROOT/patches/$f" >> "$LIST"
    done
elif [ -f "$ROOT/patches/local" ]; then
    # The personal branch's list: the patches this fork needs and upstream does not (forwarded ones included).
    while IFS= read -r name; do
        case $name in ''|'#'*) continue ;; esac
        f="$ROOT/patches/$name"
        [ -f "$f" ] || die "patches/local names $name, which is not in patches/"
        echo "$f" >> "$LIST"
    done < "$ROOT/patches/local"
else
    die "no patches/local in this checkout: switch to the local branch, or name the patches with --patches"
fi
count=$(wc -l < "$LIST" | tr -d ' ')
[ "$count" -gt 0 ] || die "no fork-only patches in $SERIES: name the ones to apply with --patches"

# Dry-run every patch on the app's engine: the first that does not fit stops the run, nothing changed yet.
while IFS= read -r f; do
    if ! (cd "$ENGINE" && patch -p1 --dry-run -s < "$f") >/dev/null 2>&1; then
        die "$(basename "$f") does not fit the app's engine: the app is on another upstream pin; build the engine with tools/engine.py tree instead"
    fi
done < "$LIST"
note "$count patches fit the app's engine"

OLD=$(cat "$ENGINE/.engine-id" 2>/dev/null || true)
mkdir -p "$(dirname "$BACKUP")"
if [ ! -d "$BACKUP" ] || [ "$(cat "$BACKUP/.engine-id" 2>/dev/null || true)" != "$OLD" ]; then
    /bin/rm -rf "$BACKUP"
    ditto "$ENGINE" "$BACKUP"
    note "kept the app's own engine ($OLD) for --restore"
fi

while IFS= read -r f; do
    (cd "$ENGINE" && patch -p1 -s < "$f") || die "$(basename "$f") failed halfway: run --restore"
    note "applied $(basename "$f")"
done < "$LIST"
find "$ENGINE" -name '*.orig' -delete

# The launcher seeds its bundled engine into the store unless the store already has that id: drop the old copy so the
# patched tree is the one a build reads.
if [ -n "$OLD" ]; then
    /bin/rm -rf "$HOME/Library/Application Support/NX2Apple/engine/$OLD"
    note "dropped the store's copy of $OLD"
fi

sign
note "done: restart NX2Apple"
