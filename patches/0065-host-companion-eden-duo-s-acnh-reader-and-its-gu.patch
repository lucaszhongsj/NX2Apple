+bool IsHeap(uint64_t p) {
+    return p >= 0x1000 && p < (uint64_t{1} << 39) && (p & 7) == 0;
+}
+std::string ItemToken(const Item8& item){
+    constexpr char hex[]="0123456789abcdef";std::string out;
+    for(uint8_t x:item){out+=hex[x>>4];out+=hex[x&15];}return out;
+}
+bool ParseToken(std::string_view token,Item8& item){
+    if(token.size()!=16)return false;
+    auto digit=[](char c){return c>='0' && c<='9' ? c-'0' : c>='a' && c<='f' ? c-'a'+10 : -1;};
+    for(size_t i=0;i<8;i++){int a=digit(token[i*2]),b=digit(token[i*2+1]);if(a<0 || b<0)return false;item[i]=uint8_t(a*16+b);}return true;
+}
