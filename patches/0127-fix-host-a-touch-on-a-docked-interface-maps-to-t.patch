From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Thu, 19 Nov 2026 08:24:17 +0800
Subject: [PATCH] fix(host): a touch on a docked interface maps to the
 control's place

A game that docks its interface to the picture's bottom while its text
keyboard is up (the ACNH patch moves the layouts' projection and records it
in its frame step page at +0x1c4) draws its controls one dock lower than the
mapped band has them, so a touch landed above them. ui_y subtracts the dock
(474 of the 1057-pixel band at 0.92) in a narrower picture, where a dock
exists at all.

Upstream-Status: pending
Reason: a docked interface draws its controls one dock below the mapped band, so a touch landed above them. The host subtracts the dock the game records, in a narrower picture
Issue: none yet: no upstream issue for the picture shape

---
 dm/host/hle_touch.c | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/dm/host/hle_touch.c b/dm/host/hle_touch.c
index c73783bc..ba72cfeb 100644
--- a/dm/host/hle_touch.c
+++ b/dm/host/hle_touch.c
@@ -33,8 +33,16 @@ static float ui_x(float x) {
 static float ui_y(float y) {
     if (!dm_fps_state) return y;
     float r; memcpy(&r, dm_fps_state + 0x58, 4);
-    if (!(r > 0.0f) || !(r < 16.0f / 9.0f)) return y;
-    float v = 0.5f + (y - 0.5f) * ((16.0f / 9.0f) / r);
+    float v = y;
+    if (r > 0.0f && r < 16.0f / 9.0f) {
+        v = 0.5f + (y - 0.5f) * ((16.0f / 9.0f) / r);
+        // A game that docks its interface to the picture's bottom while its text keyboard is up (the ACNH
+        // patch moves the interface's projection and records it in its frame step page) draws a control
+        // below where the mapped band has it: the touch that lands on it maps to a place higher in the
+        // interface, by the dock over the band's height (474 of the 1057-pixel band at 0.92)
+        uint32_t docked; memcpy(&docked, dm_fps_state + 0x1c4, 4);
+        if (docked == 1) v -= 0.4484f;
+    }
     return v < 0 ? 0 : v > 1 ? 1 : v;
 }
 static void touch_apply(const dm_touch *t, int n) {
