+    std::atomic<bool> font_ok{false}; ///< decode_font answered (labels may use the game font)
+#if EDEN_ACNH_DIAGNOSTICS
+    std::atomic<u64> img_count{0}, img_fail{0}, img_us_last{0}, img_us_max{0}, img_us_total{0};
+#endif
