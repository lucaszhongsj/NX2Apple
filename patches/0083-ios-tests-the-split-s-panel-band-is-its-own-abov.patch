From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Mon, 16 Nov 2026 21:25:55 +0800
Subject: [PATCH] ios/tests: the split's panel band is its own above the pad's
 foot

The harness expected a panel tap to land inside the pad's controls
rectangle, which held while the two shared one band. With the foot the
panel's band is above the pad, so the tap is asserted in the companion
rectangle and outside the controls one.

Upstream-Status: fork-only
Reason: the harness assertion that went with the split's separate panel band (0080); no upstream issue for the companion
Issue: none yet: no upstream issue for the companion
---
 dm/ios/tests/duo/Tests/DuoHarnessTests.m | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/dm/ios/tests/duo/Tests/DuoHarnessTests.m b/dm/ios/tests/duo/Tests/DuoHarnessTests.m
index e729d85a..169fd63c 100644
--- a/dm/ios/tests/duo/Tests/DuoHarnessTests.m
+++ b/dm/ios/tests/duo/Tests/DuoHarnessTests.m
@@ -388,7 +388,8 @@ static BOOL gDuoHarnessReduceMotionEnabled;
     XCTAssertEqual([pad hitTest:minus withEvent:nil], pad, @"A key still belongs to the pad");
     // The band's middle-left is clear of the top menu pill, the thumb groups at 0.58 down and the right-stick area: it must pass through
     CGPoint clear = CGPointMake(CGRectGetMinX(layout.companion) + 12, CGRectGetMidY(layout.companion));
-    XCTAssertTrue(CGRectContainsPoint(layout.controls, clear));
+    XCTAssertTrue(CGRectContainsPoint(layout.companion, clear) && !CGRectContainsPoint(layout.controls, clear),
+                  @"The panel's band is its own, above the pad's foot");
     XCTAssertNil([pad hitTest:clear withEvent:nil], @"No key there: the companion below receives the tap");
     // Landscape has no band: the pad keeps the whole view
     DmLayout overlay = dm_layout(CGRectMake(0, 0, 844, 390), UIEdgeInsetsZero, NO, CGRectNull, DM_PICTURE_16_9);
