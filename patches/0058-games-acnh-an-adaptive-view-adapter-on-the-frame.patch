+// Owned adaptive-view routines for ACNH main ff1d1c05670db6021c85b624a710b963.
+// The projection/scissor entry-point lead comes from the MIT-0 ACNH 3.0.X
+// Ultrawide project. Vertical coverage and dynamic cache checks are local.
+// State (the frame step page): +0x58 target aspect (0 = 16:9), +0xa0 layout match,
+// +0xa8/+0xb0/+0xb8 native UI frame stamps. No host-managed pointer is needed.
+.text
+.p2align 2
+.globl _dm_view_matrix
+_dm_view_matrix:
+    ldp s1, s2, [x0, #0xac]
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w15, [x15, #0x58]
+    cbz w15, Lmatrix_done
+    ldr s6, Lbase
+    fcmp s2, s6
+    b.ne Lmatrix_done
+    fmov s7, w15
+    fdiv s6, s6, s7
+    fmov s3, #1.0
+    fmax s6, s6, s3
+    fmul s1, s1, s6
+    fmov s2, s7
+    fmov s3, #0.5
+Lmatrix_done:
+    b _dm_return_037e5978
+
+// A cached projection must follow target changes even when the game has not
+// changed its own camera parameters. The original dirty byte is returned for
+// every other object. No padding or lifetime-sensitive pointers are written.
+.globl _dm_view_cache
+_dm_view_cache:
+    ldrb w8, [x0, #8]
+    cbnz w8, Lcache_return
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w15, [x15, #0x58]
+    cbz w15, Lcache_return
+    stp q0, q1, [sp, #-64]!
+    stp q2, q3, [sp, #32]
+    mrs x15, nzcv
+    str x15, [sp, #-16]!
+    ldr x15, [x0]
+    adrp x16, _dm_code_04a65608@PAGE
+    add x16, x16, _dm_code_04a65608@PAGEOFF
+    cmp x15, x16
+    b.ne Lcache_done
+Lcache_perspective:
+    ldr s0, [x0, #0xb0]
+Lcache_expected:
+    ldr s1, Lbase
+    fcmp s0, s1
+    b.ne Lcache_done
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w15, [x15, #0x58]
+    cbz w15, Lcache_compare
+    fmov s0, w15
+Lcache_compare:
+    ldr s1, [x0, #0xc]
+    ldr s2, [x0, #0x20]
+    fdiv s1, s2, s1
+    fabs s1, s1
+    fsub s1, s1, s0
+    fabs s1, s1
+    ldr s2, Lepsilon
+    fmul s2, s0, s2
+    fcmp s1, s2
+    cset w8, hi
+Lcache_done:
+    ldr x15, [sp], #16
+    msr nzcv, x15
+    ldp q2, q3, [sp, #32]
+    ldp q0, q1, [sp], #64
+Lcache_return:
+    ret
+
+
+// UI jobs can bypass Projection::getMatrix and return a retained override.
+// This getter belongs to the screen UI manager. Recognize its verified 40-degree
+// lens and 1..10000 depth transform, keeping square/local and off-axis captures
+// untouched. Narrow screens preserve X; wide screens preserve Y. Both values
+// are derived from the canonical lens, including restoration to target zero.
+.globl _dm_view_ui_override
+_dm_view_ui_override:
+    add x0, x8, #8
+    stp x8, x30, [sp, #-16]!
+    bl Lscreen_projection
+    ldp x8, x30, [sp], #16
+    ret
+// x0 = screen projection, w8 = accepted. No retained matrix is a scale source.
+Lscreen_projection:
+    mov w8, wzr
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w16, [x15, #0x58]
+    cbz w16, Lui_return
+    ldr w16, [x0, #0x3c]
+    cbnz w16, Lui_return
+    ldr w16, [x0, #0x38]
+    mov w14, #0xbf800000
+    cmp w16, w14
+    b.ne Lui_return
+    ldr w16, [x0, #0x28]
+    ldr w14, Lui_depth_z
+    cmp w16, w14
+    b.ne Lui_return
+    ldr w16, [x0, #0x2c]
+    ldr w14, Lui_depth_w
+    cmp w16, w14
+    b.ne Lui_return
+    ldr w16, [x0, #8]
+    ldr w14, [x0, #0x18]
+    orr w16, w16, w14
+    cbnz w16, Lui_return
+    ldr s0, [x0]
+    ldr s1, [x0, #0x14]
+    ldr s2, Lui_x
+    ldr s3, Lbase
+    ldr s4, Lepsilon
+    fsub s2, s0, s2
+    fabs s2, s2
+    fcmp s2, s4
+    b.ls Lui_apply
+    // A wider initial target retains the canonical vertical coefficient.
+    fcmp s0, #0.0
+    b.le Lui_return
+    ldr s2, Lui_x
+    fcmp s0, s2
+    b.hi Lui_return
+    fmul s2, s2, s3
+    fsub s2, s1, s2
+    fabs s2, s2
+    fcmp s2, s4
+    b.hi Lui_return
+    fdiv s0, s1, s3
+Lui_apply:
+    ldr w16, [x15, #0x58]
+    cbz w16, Lui_original
+    fmov s3, w16
+Lui_original:
+    ldr s0, Lui_x
+    ldr s2, Lbase
+    fdiv s2, s2, s3
+    fmov s4, #1.0
+    fmin s2, s2, s4
+    fmul s0, s0, s2
+    fmul s1, s0, s3
+    str s0, [x0]
+    str s1, [x0, #0x14]
+    mov w8, #1
+Lui_return:
+    ret
+Lui_x: .float 1.5454561710357666
+Lui_depth_z: .float -1.0002000331878662
+Lui_depth_w: .float -2.000200033187866
+
+// Scissor conversion follows the current perspective matrix. Capture-local
+// orthographic projections retain their native coordinates. Preserve NZCV.
+.globl _dm_view_scissor
+_dm_view_scissor:
+    fdiv s3, s0, s2
+    fdiv s2, s1, s4
+    stp x15, x16, [sp, #-16]!
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w15, [x15, #0x58]
+    cbz w15, Lscissor_done
+    ldr w16, [x19, #0x4c]
+    cbnz w16, Lscissor_done
+    stp q5, q6, [sp, #-48]!
+    str q7, [sp, #32]
+    // Match the actual projection to this layout's reference rectangle.
+    ldr s5, [x19, #0x24]
+    ldr s6, [x19, #0x10]
+    fdiv s5, s5, s6
+    fabs s5, s5
+    ldr x15, [x19, #0xc0]
+    ldp s6, s7, [x15, #0x28]
+    fdiv s6, s6, s7
+    fdiv s5, s5, s6
+    // A target narrower than stock extends Y; a wider target extends X.
+    fmov s6, #1.0
+    fmin s6, s6, s5
+    fmul s2, s2, s6
+    fmov s6, #1.0
+    fdiv s5, s6, s5
+    fmin s5, s5, s6
+    fmul s3, s3, s5
+    ldr q7, [sp, #32]
+    ldp q5, q6, [sp], #48
+Lscissor_done:
+    ldp x15, x16, [sp], #16
+    b _dm_return_03a308f0
+
+.globl _dm_view_capture
+_dm_view_capture:
+    fdiv s2, s9, s2
+    stp x15, x16, [sp, #-16]!
+    adrp x15, _dm_view_state@PAGE
+    add x15, x15, _dm_view_state@PAGEOFF
+    ldr w15, [x15, #0x58]
+    cbz w15, Lcapture_done
+    ldr w16, [x21, #0x4c]
+    cbnz w16, Lcapture_done
+    stp q4, q5, [sp, #-48]!
+    str q6, [sp, #32]
+    ldr s4, [x21, #0x24]
+    ldr s5, [x21, #0x10]
+    fdiv s4, s4, s5
+    fabs s4, s4
+    ldr x15, [x21, #0xc0]
+    ldp s5, s6, [x15, #0x28]
+    fdiv s5, s5, s6
+    fdiv s4, s4, s5
+    fmov s5, #1.0
+    fmin s5, s5, s4
+    fmul s3, s3, s5
+    fmov s5, #1.0
+    fdiv s4, s5, s4
+    fmin s4, s4, s5
+    fmul s2, s2, s4
+    ldr q6, [sp, #32]
+    ldp q4, q5, [sp], #48
+Lcapture_done:
+    ldp x15, x16, [sp], #16
+    b _dm_return_03a2eac0
+
+// Field rectangles select which terrain, trees and items are instantiated.
+// Extend depth as well as width; the margin covers the five-unit cell grid.
+.globl _dm_view_create
+_dm_view_create:
+    str x15, [sp, #-16]!
