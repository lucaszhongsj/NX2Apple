+    CHECK(touch_samp == n0 && touch_points == 1 && touch_num(s2) == touch_num(s), "touch: a mode change within 4 ms shares the sample, points and all");
+    motion_now += TOUCH_GRID_NS; memset(s2, 0xA5, sizeof s2); h_hid_Touch1_16(s2);
