From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Tue, 17 Nov 2026 06:52:38 +0800
Subject: [PATCH] ios: give the picture half the screen and gate the panel on
 Tap

A handheld launch asks for the shape of half the screen so the picture fills the upper half and the panel the lower half. The panel takes touches only in the Tap layout; in 3D the pad owns the whole band.

Upstream-Status: fork-only
Reason: the handheld launch takes the shape of half the screen, and the panel follows the Tap layout
Issue: none yet: no upstream issue for the companion

---
 dm/ios/Sources/DmGamepad.m               |  4 +-
 dm/ios/Sources/DmLayout.h                | 25 ++++---
 dm/ios/Sources/front_ios.m               |  9 +--
 dm/ios/tests/duo/Tests/DuoHarnessTests.m | 83 +++++++++++++-----------
 4 files changed, 64 insertions(+), 57 deletions(-)

diff --git a/dm/ios/Sources/DmGamepad.m b/dm/ios/Sources/DmGamepad.m
index 98bc40ab..4049a063 100644
--- a/dm/ios/Sources/DmGamepad.m
+++ b/dm/ios/Sources/DmGamepad.m
@@ -451,8 +451,8 @@ int front_web_touch(void);
         if (_padOff && !_layout.onTV && e && e.type == UIEventTypeTouches) [self wakeMenu];
         return nil;
     }
-    if (_tap) return nil;   // the Tap layout has no controls: the whole view, band included, belongs to the game or the panel
-    if (_layout.separated && CGRectContainsPoint(_layout.companion, p) && ![self controlAt:p]) return nil;   // a tap on no key goes through to the panel (tabs, item slots)
+    if (_tap) return nil;   // Tap hides the pad: every touch goes to the game or the panel, so the panel is tappable here
+    if (_layout.separated && CGRectContainsPoint(_layout.controls, p)) return self;   // 3D owns the whole band: the panel below is not tappable
     return v;
 }
 - (void)touchesBegan:(NSSet<UITouch *> *)ts withEvent:(UIEvent *)e {
diff --git a/dm/ios/Sources/DmLayout.h b/dm/ios/Sources/DmLayout.h
index d6908a5a..120129b3 100644
--- a/dm/ios/Sources/DmLayout.h
+++ b/dm/ios/Sources/DmLayout.h
@@ -42,11 +42,11 @@ static inline CGRect dm_aspect_fill(CGRect b, CGFloat aspect) {
 static inline BOOL dm_picture_fill(const char *_Nullable value) { return value && !strcmp(value, "fill"); }   // DM_PICTURE_FIT: fit (default) or fill
 
 // Picture shape "auto" (the launcher's Match screen): the window's own shape when it is taller than 16:9 (an iPad's 4:3, an unfolded iPhone Duo's 1.43:1) or
-// wider (a 19.5:9 phone lying down at 2.17:1), else 16:9. A phone standing up takes the shape of its picture's band instead (half the window): the splash
-// of a wide screen turned on its side, so the game fills the band without cropping. The range is loader.c's (0.9 to 2.4). 0 = 16:9.
+// wider (a 19.5:9 phone lying down at 2.17:1), else 16:9. A phone standing up takes the shape of half the window: the picture fills the upper 50% of the
+// screen without cropping, the panel the lower 50%. The range is loader.c's (0.9 to 2.4). 0 = 16:9.
 static inline float dm_picture_shape_auto(CGSize window) {
-    if (window.height > window.width) return 0.0f;   // standing up: 16:9, which the split's band fits whole
-    double r = MAX(window.width, window.height) / MAX(MIN(window.width, window.height), 1);
+    double r = window.height > window.width ? window.width / MAX(window.height * 0.5, 1)
+                                            : MAX(window.width, window.height) / MAX(MIN(window.width, window.height), 1);
     return r >= 0.9 && r < 2.4 ? (float)r : 0.0f;
 }
 
@@ -68,17 +68,16 @@ static inline DmLayout dm_layout(CGRect b, UIEdgeInsets insets, BOOL partiallyOp
     division = dm_horizontal_division(b, division);
     BOOL portrait = b.size.height > b.size.width;
     if (!portrait && (!partiallyOpen || CGRectIsNull(division))) return l;
+    // A phone standing up with no fold splits the screen at its midpoint: the picture takes the upper half, the panel the lower half. The picture's shape
+    // is computed for that half at launch (dm_picture_shape_auto), so it fills the upper rectangle without bars. A fold sets both edges within the safe area.
+    BOOL folded = !CGRectIsNull(division);
     CGRect safe = UIEdgeInsetsInsetRect(b, insets);
-    // Where the picture's part ends and the band begins. A phone standing up with no fold gives the picture the height its own width asks for, so a 16:9
-    // picture has no bars above or below: halving a 19.5:9 phone leaves 9:9.75, where nearly half of the picture's part was bars. It never takes more than
-    // half the window, so a squarer window keeps the midpoint: an iPad's 4:3 asks for 570 of 820 across, over half, and the band keeps at least half. A
-    // taller picture (an iPad mini's 1.52) is the picture's own height either way, so only the bars it used to have go to the band. A fold sets both edges.
-    CGFloat upperBottom = CGRectIsNull(division) ? MIN(CGRectGetMidY(b), CGRectGetMinY(safe) + safe.size.width / MAX(aspect, 0.001))
-                                                 : CGRectGetMinY(division);
-    CGFloat bandTop = CGRectIsNull(division) ? upperBottom : CGRectGetMaxY(division);
-    CGRect upper = CGRectMake(CGRectGetMinX(safe), CGRectGetMinY(safe), safe.size.width, upperBottom - CGRectGetMinY(safe));
+    CGFloat upperBottom = folded ? CGRectGetMinY(division) : CGRectGetMidY(b);
+    CGFloat bandTop = folded ? CGRectGetMaxY(division) : upperBottom;
+    CGRect upper = folded ? CGRectMake(CGRectGetMinX(safe), CGRectGetMinY(safe), safe.size.width, upperBottom - CGRectGetMinY(safe))
+                          : CGRectMake(CGRectGetMinX(b), CGRectGetMinY(b), b.size.width, upperBottom - CGRectGetMinY(b));
     CGRect lower = CGRectMake(CGRectGetMinX(b), bandTop, b.size.width, CGRectGetMaxY(b) - bandTop);
-    if (upper.size.height <= 0 || CGRectGetMaxY(safe) <= CGRectGetMinY(lower)) return l;
+    if (upper.size.height <= 0) return l;
     l.game = dm_aspect_fit(upper, aspect); l.companion = lower; l.controls = lower; l.separated = YES;
     return l;
 }
diff --git a/dm/ios/Sources/front_ios.m b/dm/ios/Sources/front_ios.m
index ad7caeaf..bfc3db9c 100644
--- a/dm/ios/Sources/front_ios.m
+++ b/dm/ios/Sources/front_ios.m
@@ -191,17 +191,18 @@ static void launcher_done(void) { [g_root startGame]; }
     if (dev) { [self showHint:[NSString stringWithFormat:@"This device is not supported.\n%s", dev]]; return; }   // the host does not start
     {   // Picture shape "auto" (the launcher's Match screen): the app window's own shape when it is taller or wider than 16:9 (an iPad's 4:3, an unfolded iPhone Duo's 1.43:1,
         // a 19.5:9 phone in landscape at 2.17:1), else 16:9. The window's, not the screen's: on an iPad under Stage Manager or Split View the app does not fill the screen. Resolved
-        // here, before the host writes the state page (main.c dm_fps_state_apply). A phone standing up keeps 16:9 (DmLayout.h dm_picture_shape_auto): its picture sits above
-        // the controls, where a picture of its own 1.78 to 2.16:1 shape would be shorter than the 16:9 one
+        // here, before the host writes the state page (main.c dm_fps_state_apply). The console mode picks the calculation: handheld takes the shape of half the
+        // screen, so the picture fills the upper half and the panel the lower half; docked takes the screen's own wide shape. Physical rotation changes neither.
         const char *a = getenv("DM_SCREEN_ASPECT");
         if (a && !strcmp(a, "auto")) {
             // The window's bounds are still the other shape on a cold start (the scene turns after this call). Use the screen's physical size and put its
             // edges in the order the scene's orientation says, so a phone launched lying down resolves to its wide shape, not to 16:9.
             CGSize sz = UIScreen.mainScreen.bounds.size;
-            // The console mode is the choice: handheld is the split's 16:9 picture, docked is the screen's own wide shape. Physical rotation changes nothing.
+            // The console mode is the choice: handheld is the split's half-screen picture, docked is the screen's own wide shape. Rotation changes nothing.
             BOOL handheld = dm_opmode() == 0;
+            if (handheld && sz.width > sz.height) sz = CGSizeMake(sz.height, sz.width);   // the picture's band is the short side x half the long side
             if (!handheld && sz.width < sz.height) sz = CGSizeMake(sz.height, sz.width);
-            float r = handheld ? 0 : dm_picture_shape_auto(sz);
+            float r = dm_picture_shape_auto(sz);
             char v[16]; if (r > 0) snprintf(v, sizeof v, "%.3f", r); else strcpy(v, "0");
             setenv("DM_SCREEN_ASPECT", v, 1); LOG("front end: picture shape auto: screen %.0fx%.0f points (%s) → DM_SCREEN_ASPECT=%s", sz.width, sz.height, handheld ? "handheld" : "docked", v);
         }
