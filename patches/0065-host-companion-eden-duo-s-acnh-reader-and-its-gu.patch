+// Generated from the 3.0.3 main (build ff1d1c05670db602...).
+// Exact instruction words; a mismatch turns the Bag page writes off (bag.why "code").
+// SwapSlots: global i < min([Baggage+0x158] ItemPocket count, 20) -> ItemPocket items Baggage+0xb8+i*8, else ItemBag Baggage+(i-n)*8 while < min([+0xa0], 20)
+inline const BagPin PinBagSwap{"BagSwap", 0x26fd1f8, {0xb9415808, 0x52800299, 0xaa0103f5, 0xaa0203f3, 0xaa0003f4, 0x92407c36, 0x9102e018, 0x7100511f, 0x1a993108, 0x6b0802a8, 0x54000062, 0x8b160f17, 0x14000008, 0x54000444, 0xb940a289, 0x7100513f, 0x1a993129, 0x6b08013f, 0x540003a9, 0x8b284e97}};
+// SwapSlots favourites: i < n -> Baggage+0x15c+i (ItemPocket), else Baggage+0xa4+(i-n) (ItemBag); index > 0x27 -> 0xff
+inline const BagPin PinBagSwapFav{"BagSwapFav", 0x26fd378, {0x71009ebf, 0x8b16029b, 0x290023e9, 0x540001c8, 0xb9415a88, 0x9102928a, 0x7100511f, 0x1a993108, 0x6b0802a9, 0x8b09014b, 0x7100513f, 0x9a8a3169, 0x6b0802bf, 0x91057368, 0x9a893108, 0x39400118}};
