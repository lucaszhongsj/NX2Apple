+using Item8 = std::array<uint8_t, 8>;
+inline constexpr Item8 EmptyItem{0xFE, 0xFF, 0, 0, 0, 0, 0, 0};
+inline bool IsEmpty(const Item8& it) {
+    return it[0] == 0xFE && it[1] == 0xFF;
+}
+inline uint16_t ItemId(const Item8& it) {
