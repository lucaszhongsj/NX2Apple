From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: lucaszhongsj <lucaszhongsj@foxmail.com>
Date: Mon, 16 Nov 2026 02:49:07 +0800
Subject: [PATCH] ios: record the launcher that built an app (DMBuildVersion)

A launcher carrying hand-applied patches builds an app whose
CFBundleShortVersionString is still the game's version, so nothing in
the app said which launcher made it. build_ipa.sh writes
DMBuildVersion from DM_BUILD_VERSION (the launcher's own display
version) and the host prints it on the second line of its log, next to
the fork patches.

Upstream-Status: fork-only
Reason: A launcher with hand-applied patches builds apps whose game version says nothing about the launcher, so DMBuildVersion records it in Info.plist and the host log
Issue: LNPANDY/NX2Apple#1351

---
 dm/ios/Sources/main.m     | 3 +++
 dm/ios/tools/build_ipa.sh | 5 +++++
 2 files changed, 8 insertions(+)

diff --git a/dm/ios/Sources/main.m b/dm/ios/Sources/main.m
index dd0b997..2408fff 100644
--- a/dm/ios/Sources/main.m
+++ b/dm/ios/Sources/main.m
@@ -244,6 +244,9 @@ static int boot_env(void) {
     // First line of the log: the fork's patches this build carries (Info.plist DMForkPatches), so a report says whether it comes from a build beyond upstream's support
     NSString *fork_patches = [NSBundle.mainBundle objectForInfoDictionaryKey:@"DMForkPatches"];
     fprintf(stderr, "fork patches: %s\n", [fork_patches isKindOfClass:NSString.class] && fork_patches.length ? fork_patches.UTF8String : "none");
+    // The launcher that built it (DMBuildVersion), when it was one whose version carries a fork mark: a report says which build made the app
+    NSString *build_version = [NSBundle.mainBundle objectForInfoDictionaryKey:@"DMBuildVersion"];
+    if ([build_version isKindOfClass:NSString.class] && build_version.length) fprintf(stderr, "built by: NX2Apple %s\n", build_version.UTF8String);
 #if DM_FRAMEWORK_BUILD
     // Route C: the runtime profile ships inside the game framework, and dm_profile() (hle_profile.c) reads DM_PROFILE on its
     // first call below (front_hud_env, romfs_locate, the per-game data folders). Before the env files, and forced: the game
diff --git a/dm/ios/tools/build_ipa.sh b/dm/ios/tools/build_ipa.sh
index a5dfff4..d6f19ec 100755
--- a/dm/ios/tools/build_ipa.sh
+++ b/dm/ios/tools/build_ipa.sh
@@ -317,6 +317,11 @@ else xcodegen generate -q --spec project-framework.yml > /dev/null || die "xcode
 # DMCommit / DMChain: the checkout that built the app (+dirty with uncommitted changes to tracked files) and the shader chain it carries, which the host logs at start (main.c)
 COMMIT=$(git -C "$DM" rev-parse --short=12 HEAD 2> /dev/null) && { [ -z "$(git -C "$DM" status --porcelain --untracked-files=no 2> /dev/null)" ] || COMMIT=$COMMIT+dirty
   /usr/libexec/PlistBuddy -c "Add :DMCommit string $COMMIT" Gen/Info.plist > /dev/null || die "DMCommit"; t "source: $COMMIT"; }
+# DMBuildVersion: the launcher that built this app (DM_BUILD_VERSION, the front end's own display version), so a build made by a
+# patched launcher says so next to the game's version, which stays the game's (CFBundleShortVersionString is what the launcher
+# shows and compares, so it never carries this mark)
+if [ -n "${DM_BUILD_VERSION:-}" ]; then
+  /usr/libexec/PlistBuddy -c "Add :DMBuildVersion string $DM_BUILD_VERSION" Gen/Info.plist > /dev/null || die "DMBuildVersion"; t "built by: NX2Apple $DM_BUILD_VERSION"; fi
 case "$MSLDIR" in b-*) /usr/libexec/PlistBuddy -c "Add :DMChain string ${MSLDIR#b-}" Gen/Info.plist > /dev/null || die "DMChain";; esac
 # DM_METAL_CAPTURE=1: a development build that may write GPU frame captures (MetalCaptureEnabled; the host's DM_GPU_CAPTURE switch writes them to Documents/gpu_captures)
 if [ "${DM_METAL_CAPTURE:-0}" = 1 ]; then /usr/libexec/PlistBuddy -c "Add :MetalCaptureEnabled bool true" Gen/Info.plist > /dev/null || die "MetalCaptureEnabled"; t "Metal frame capture: enabled (DM_METAL_CAPTURE=1)"; fi
